# thirdweb client id — https://thirdweb.com/dashboard -> Settings -> API Keys.
# Add http://localhost:3000 to the key's allowed domains.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# Address printed by contracts/scripts/deploy.ts
NEXT_PUBLIC_CONTRACT_ADDRESS=

# "fuji" (testnet, dev/staging) or "mainnet" (Avalanche C-Chain, production).
# Kept explicit so the chain is never ambiguous — any other value throws at startup.
NEXT_PUBLIC_CHAIN=fuji

# The org this deployment's UI is pinned to (seed.ts registers org #1).
NEXT_PUBLIC_ORG_ID=1

# Block the contract was deployed in (see contracts/deployments.json). Event
# scanning starts here — leaving it 0 still works but is much slower on Fuji.
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Address allowed into /org. Set this to the org approver's wallet address
# once you know it; leave blank during development to let any signed-in account in.
NEXT_PUBLIC_ORG_APPROVER=

# Neon Postgres — the off-chain queue, engagement types and CRM.
# SERVER ONLY. Do not add a NEXT_PUBLIC_ prefix: that inlines the value into the
# browser bundle, and this is a database password.
# Apply the schema with:  psql "$DATABASE_URL" -f db/001_init.sql
DATABASE_URL=

# Optional — campaign cover uploads on Vercel (unsigned preset). Without these,
# localhost stores files in public/campaign-covers/.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=

# In-app faucet — pushes a little AVAX to brand-new wallets so nobody has to go find
# a faucet or an exchange. SERVER ONLY, like DATABASE_URL. Use a fresh key holding
# a small reserve (it is the faucet), never the deployer or the org approver.
# Leave blank to turn the faucet off — the UI falls back to manual instructions.
FAUCET_PRIVATE_KEY=

# How much each new wallet gets. The gate needs 0.001, so 0.005 is 5x headroom —
# 1 AVAX of reserve funds ~200 wallets, and each wallet's drip covers thousands of
# transactions at typical gas prices.
FAUCET_DRIP_AVAX=0.005

# MAINNET ONLY: drips are real AVAX, so the faucet stays off on mainnet unless this
# is exactly "1". Default daily caps also tighten on mainnet (2/IP, 50 global;
# worst case 50 x 0.005 = 0.25 AVAX/day) — raise them deliberately for an event.
FAUCET_ALLOW_MAINNET=
# FAUCET_IP_DAILY_LIMIT=
# FAUCET_GLOBAL_DAILY_LIMIT=

# Business waitlist → Google Sheet (SERVER ONLY).
# 1. Create a sheet with columns: Timestamp | Name | Email | Phone
# 2. Extensions → Apps Script → paste the doPost handler (see docs in repo or team wiki)
# 3. Deploy → New deployment → Web app → Execute as: Me, Who has access: Anyone
# 4. Paste the deployment URL here (ends in /exec)
GOOGLE_SHEETS_WAITLIST_URL=

# M-Pesa referral pilot (SERVER ONLY). Verifies a referred Till payment via Daraja C2B.
# We only READ payments (attribution) — no custody/payout — so no VASP trigger.
# From https://developer.safaricom.co.ke → your app's Consumer Key/Secret.
MPESA_ENV=sandbox                 # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=                  # the pilot Till / shortcode to register + simulate
MPESA_CALLBACK_BASE_URL=          # public base Daraja calls back on, e.g. https://ubutangaza.biz
# Gate for POST /api/mpesa/setup (register C2B URLs / sandbox-simulate). Pick any secret.
MPESA_ADMIN_SECRET=

# Campaign-credit billing (db/021, lib/billing.ts).
# Gate for POST /api/billing/confirm and the /admin/billing console. Pick any secret.
BILLING_ADMIN_SECRET=
# Where businesses send the money, shown verbatim at checkout once the ramp is chosen,
# e.g. "M-Pesa Send Money to 07XX XXX XXX (Autopay)". Blank = checkout points to WhatsApp.
BILLING_PAY_INSTRUCTIONS=

# Automatic matching (lib/billing-match.ts) — each is optional and off until set.
# OUR OWN Till/Paybill: payments to it on the Daraja webhook become campaign credits,
# matched by reference code then exact amount, instead of merchant referral sales.
BILLING_MPESA_SHORTCODE=
# On-chain watcher: the address the ramp settles stablecoin to, and the token contract
# (assumed 6 decimals, e.g. USDC). Matched against each intent's unique micro-amount.
BILLING_RECEIVE_ADDRESS=
BILLING_TOKEN_ADDRESS=
# If set, GET /api/billing/recheck (the hourly cron in vercel.json) requires
# "Authorization: Bearer <this>" — Vercel sends it automatically on scheduled runs.
CRON_SECRET=

# Optional: shows a WhatsApp button on the public site, e.g. https://wa.me/2547XXXXXXXX
NEXT_PUBLIC_WHATSAPP_URL=

# RPC endpoints, one pair per chain — NEXT_PUBLIC_CHAIN picks which pair is read, so
# both can coexist (e.g. Fuji in Preview, mainnet in Production on Vercel). Blank =
# Avalanche's public endpoint. To use a dedicated provider (AvaCloud, Alchemy, Infura,
# Ankr) put its URL here. The NEXT_PUBLIC ones ship to the browser, so restrict any
# key in them to your domain; the server-only ones win on the server if both are set.
NEXT_PUBLIC_FUJI_RPC_URL=
FUJI_RPC_URL=
NEXT_PUBLIC_AVALANCHE_RPC_URL=
AVALANCHE_RPC_URL=

# AvaCloud/Glacier Data API key (x-glacier-api-key) for event reads. Keyless works on
# Fuji; get a key for mainnet traffic. Ships to the browser — restrict it to your domain.
NEXT_PUBLIC_AVACLOUD_API_KEY=

# Contract owner's key for instant org registration (/register). SERVER ONLY. Without
# it, applications queue on /admin for manual registration. On mainnet this is a real
# hot key: keep only a minimal gas balance on it.
PLATFORM_OWNER_KEY=

# SerpApi key (serpapi.com) — used by the business-outreach workflow to find businesses. Server/local only: never NEXT_PUBLIC_.
SERPAPI_API_KEY=

# Outreach console (/admin/outreach) — server-only, never NEXT_PUBLIC_.
# NOTION_API_KEY: internal integration secret; share the "Business Outreach Tracker" database with it.
NOTION_API_KEY=
# Optional: defaults to the Business Outreach Tracker database.
OUTREACH_NOTION_DB_ID=
# The "Start run" button POSTs { text, params } here with a bearer token (a routine's API trigger).
# Addresses (comma-separated) allowed into /admin/outreach besides the contract owner — use the account you sign in with.
OUTREACH_ADMINS=
OUTREACH_RUN_URL=
OUTREACH_RUN_TOKEN=

# In-app outreach run (/admin/outreach "Start run") — server-only, never NEXT_PUBLIC_.
# SERPAPI_API_KEY (above) finds businesses; GEMINI_API_KEY researches them and writes the draft.
GEMINI_API_KEY=
# Optional. Defaults to an alias that follows the current Flash model; pin one if you prefer.
GEMINI_MODEL=
# Optional: sign-off name and the booking link used in drafts.
OUTREACH_SENDER_NAME=
OUTREACH_BOOKING_URL=

# Model for the in-app outreach run. Claude is used when ANTHROPIC_API_KEY is set (cheapest: Haiku 4.5);
# set OUTREACH_LLM=gemini to force Gemini instead.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-4-5.
ANTHROPIC_MODEL=
OUTREACH_LLM=

# Sending outreach drafts from /admin/outreach (per-row, owner-signed; nothing automatic).
# Your mail host's SMTP for danielmwihoti@ubutangaza.biz: host, port (465 or 587), login, password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: the From shown to recipients (defaults to SMTP_USER / "Ubu-Tangaza").
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=
