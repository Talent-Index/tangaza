# Deployer key for Avalanche Fuji. Fund it from https://core.app/tools/testnet-faucet/
# (select Avalanche Fuji C-Chain). No 0x prefix needed either way.
PRIVATE_KEY=

# Fuji C-Chain RPC. The public endpoint is fine for the jam.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Optional: only needed for `npx hardhat verify`. Routescan accepts any non-empty
# string for Fuji, so "verifyContract" works if you have no real key.
SNOWTRACE_API_KEY=

# Set after `npx hardhat run scripts/deploy.ts --network fuji` so seed.ts can find it.
CONTRACT_ADDRESS=

# Org the seed script registers/uses.
ORG_NAME=Blockchain Centre Kenya
ORG_APPROVER=
ORG_EMISSION_CAP_KES=50000
