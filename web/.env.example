# thirdweb client id — https://thirdweb.com/dashboard -> Settings -> API Keys.
# Add http://localhost:3000 to the key's allowed domains.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# Address printed by contracts/scripts/deploy.ts
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Fuji only for the jam. Kept explicit so the chain is never ambiguous.
NEXT_PUBLIC_CHAIN=fuji

# The org this deployment's UI is pinned to (seed.ts registers org #1).
NEXT_PUBLIC_ORG_ID=1

# Block the contract was deployed in (see contracts/deployments.json). Event
# scanning starts here — leaving it 0 still works but is much slower on Fuji.
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Address allowed into /org. Set this to the org approver's smart-account address
# once you know it; leave blank during development to let any signed-in account in.
NEXT_PUBLIC_ORG_APPROVER=

# Neon Postgres — the off-chain queue, engagement types and CRM.
# SERVER ONLY. Do not add a NEXT_PUBLIC_ prefix: that inlines the value into the
# browser bundle, and this is a database password.
# Apply the schema with:  psql "$DATABASE_URL" -f db/001_init.sql
DATABASE_URL=

# Optional — campaign cover uploads on Vercel (unsigned preset). Without these,
# localhost stores files in public/campaign-covers/.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=

# In-app faucet — pushes a little Fuji AVAX to brand-new wallets so nobody has to
# go find a testnet faucet. SERVER ONLY, like DATABASE_URL. Use a fresh key holding
# a small reserve (it is the faucet), never the deployer or the org approver.
# Leave blank to turn the faucet off — the UI falls back to Core faucet instructions.
FAUCET_PRIVATE_KEY=

# How much each new wallet gets. The gate needs 0.001, so 0.005 is 5x headroom —
# 1 AVAX of reserve funds ~200 wallets, and each wallet's drip covers thousands of
# transactions at Fuji gas prices.
FAUCET_DRIP_AVAX=0.005

# Business waitlist → Google Sheet (SERVER ONLY).
# 1. Create a sheet with columns: Timestamp | Name | Email | Phone
# 2. Extensions → Apps Script → paste the doPost handler (see docs in repo or team wiki)
# 3. Deploy → New deployment → Web app → Execute as: Me, Who has access: Anyone
# 4. Paste the deployment URL here (ends in /exec)
GOOGLE_SHEETS_WAITLIST_URL=

# M-Pesa referral pilot (SERVER ONLY). Verifies a referred Till payment via Daraja C2B.
# We only READ payments (attribution) — no custody/payout — so no VASP trigger.
# From https://developer.safaricom.co.ke → your app's Consumer Key/Secret.
MPESA_ENV=sandbox                 # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=                  # the pilot Till / shortcode to register + simulate
MPESA_CALLBACK_BASE_URL=          # public base Daraja calls back on, e.g. https://ubutangaza.biz
# Gate for POST /api/mpesa/setup (register C2B URLs / sandbox-simulate). Pick any secret.
MPESA_ADMIN_SECRET=

# Optional: shows a WhatsApp button on the public site, e.g. https://wa.me/2547XXXXXXXX
NEXT_PUBLIC_WHATSAPP_URL=

# RPC endpoint for Avalanche Fuji. Blank = Avalanche's public endpoint. To use a
# dedicated provider (AvaCloud, Alchemy, Infura, Ankr) put its Fuji URL here. The
# NEXT_PUBLIC one ships to the browser, so restrict any key in it to your domain;
# FUJI_RPC_URL is server-only and wins on the server if both are set.
NEXT_PUBLIC_FUJI_RPC_URL=
FUJI_RPC_URL=

# SerpApi key (serpapi.com) — used by the business-outreach workflow to find businesses. Server/local only: never NEXT_PUBLIC_.
SERPAPI_API_KEY=

# Outreach console (/admin/outreach) — server-only, never NEXT_PUBLIC_.
# NOTION_API_KEY: internal integration secret; share the "Business Outreach Tracker" database with it.
NOTION_API_KEY=
# Optional: defaults to the Business Outreach Tracker database.
OUTREACH_NOTION_DB_ID=
# The "Start run" button POSTs { text, params } here with a bearer token (a routine's API trigger).
# Addresses (comma-separated) allowed into /admin/outreach besides the contract owner — use the account you sign in with.
OUTREACH_ADMINS=
OUTREACH_RUN_URL=
OUTREACH_RUN_TOKEN=

# In-app outreach run (/admin/outreach "Start run") — server-only, never NEXT_PUBLIC_.
# SERPAPI_API_KEY (above) finds businesses; GEMINI_API_KEY researches them and writes the draft.
GEMINI_API_KEY=
# Optional. Defaults to an alias that follows the current Flash model; pin one if you prefer.
GEMINI_MODEL=
# Optional: sign-off name and the booking link used in drafts.
OUTREACH_SENDER_NAME=
OUTREACH_BOOKING_URL=
